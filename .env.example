# Copy to a private file and export variables into the app process.
# Do not commit your filled-in file. All secrets must come from your host's secret store.

# MySQL 8.4+
SKILLSWAP_DB_URL=jdbc:mysql://localhost:3306/skillswap?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SKILLSWAP_DB_USERNAME=skillswap
SKILLSWAP_DB_PASSWORD=
SKILLSWAP_DB_POOL_SIZE=10
# Docker Compose local database only; use a separate random value from SKILLSWAP_DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

# Generate with: openssl rand -base64 32
# Required when TOTP setup is enabled; never reuse this key for another application.
SKILLSWAP_ENCRYPTION_KEY=

# Local development only. False for plain HTTP localhost; true behind production HTTPS.
SKILLSWAP_COOKIE_SECURE=false
SKILLSWAP_SESSION_TIMEOUT=30m
SPRING_PROFILES_ACTIVE=dev

# Public site origin (used for verification/reset/OAuth callback URLs when implemented)
SKILLSWAP_BASE_URL=http://localhost:8080
SKILLSWAP_SUPPORT_EMAIL=

# Optional SMTP. If unset in the dev profile, outgoing mail is captured by the dev outbox.
SKILLSWAP_SMTP_HOST=
SKILLSWAP_SMTP_PORT=587
SKILLSWAP_SMTP_USERNAME=
SKILLSWAP_SMTP_PASSWORD=
SKILLSWAP_MAIL_FROM=
SKILLSWAP_DEV_OUTBOX=true

# Optional first admin. Use a unique password; bootstrap behavior is being implemented.
SKILLSWAP_ADMIN_EMAIL=
SKILLSWAP_ADMIN_PASSWORD=

# Optional OAuth provider credentials. Social sign-in is not enabled until the provider's
# official app, callback URL, consent, and credential setup have been completed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional database for test profile (must be disposable and separate from development data)
SKILLSWAP_TEST_DB_URL=jdbc:mysql://localhost:3306/skillswap_test?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SKILLSWAP_TEST_DB_USERNAME=skillswap
SKILLSWAP_TEST_DB_PASSWORD=
